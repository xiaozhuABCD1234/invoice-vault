# 应用配置（环境变量前缀 IV_，默认读取 backend/.env）
IV_APP_NAME=发票管理系统 API
IV_API_PREFIX=/api/v1

# SQLite 数据库；相对路径以启动时工作目录（backend/）为准
IV_DATABASE_URL=sqlite:///./data/app.db
IV_UPLOAD_DIR=data/uploads
IV_SQL_ECHO=false

# JWT：生产环境必须替换为随机长字符串
IV_JWT_SECRET=please-change-this-development-secret
IV_JWT_ALGORITHM=HS256
IV_ACCESS_TOKEN_MINUTES=15
IV_REFRESH_TOKEN_DAYS=7

# refresh cookie
IV_COOKIE_SECURE=false
IV_REFRESH_COOKIE_NAME=refresh_token
IV_REFRESH_COOKIE_PATH=/api/v1/auth

# CORS：JSON 数组或逗号分隔
IV_CORS_ORIGINS=["http://localhost:5173"]

# 登录锁定与上传限制
IV_LOCKOUT_THRESHOLD=5
IV_LOCKOUT_MINUTES=15
IV_MAX_UPLOAD_BYTES=20971520

# 响应头 trace id 名称
IV_TRACE_HEADER=X-Trace-Id
