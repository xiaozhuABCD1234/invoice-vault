# 应用配置（环境变量前缀 IV_，默认读取 backend/.env）
IV_APP_NAME=发票管理系统 API
IV_API_PREFIX=/api/v1

# SQLite 数据库；相对路径以启动时工作目录（backend/）为准
IV_DATABASE_URL=sqlite:///./data/app.db
IV_UPLOAD_DIR=data/uploads
IV_SQL_ECHO=false

# JWT：生产环境必须替换为随机长字符串
IV_JWT_SECRET=please-change-this-development-secret
IV_JWT_ALGORITHM=HS256
IV_ACCESS_TOKEN_MINUTES=15
IV_REFRESH_TOKEN_DAYS=7

# refresh cookie
IV_COOKIE_SECURE=false
IV_REFRESH_COOKIE_NAME=refresh_token
IV_REFRESH_COOKIE_PATH=/api/v1/auth

# CORS：JSON 数组或逗号分隔
IV_CORS_ORIGINS=["http://localhost:5173"]

# 登录锁定与上传限制
IV_LOCKOUT_THRESHOLD=5
IV_LOCKOUT_MINUTES=15
IV_MAX_UPLOAD_BYTES=20971520

# 响应头 trace id 名称
IV_TRACE_HEADER=X-Trace-Id

# 识别引擎（由 extraction/config.py 直接读取；这里只是初始值，
# 管理端「识别设置」保存后写入数据库并优先生效）
# provider: pdf_text / paddleocr_local / multimodal_llm / mock / auto
IV_EXTRACTION_PROVIDER=pdf_text
# auto 模式的尝试顺序，逗号分隔；未配置的 provider 会被跳过
IV_EXTRACTION_AUTO_CHAIN=pdf_text,paddleocr_local,multimodal_llm
# 本地 PaddleOCR HTTP 端点，例如 http://127.0.0.1:8866/predict/ocr_system
IV_PADDLEOCR_ENDPOINT=
# 多模态大模型（OpenAI 兼容接口，默认关闭；开启会把发票图片发往外部）
IV_LLM_ENDPOINT=
IV_LLM_API_KEY=
IV_LLM_MODEL=
IV_LLM_ENABLED=false
# prompt 版本、HTTP 超时（秒）、最大尝试次数、running 超时回收（分钟）、退避基数（秒）
IV_EXTRACTION_PROMPT_VERSION=v1
IV_EXTRACTION_HTTP_TIMEOUT=10
IV_EXTRACTION_MAX_ATTEMPTS=3
IV_EXTRACTION_STALE_MINUTES=15
IV_EXTRACTION_BACKOFF_SECONDS=30
